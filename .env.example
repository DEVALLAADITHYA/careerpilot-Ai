GROQ_API_KEY=enetr api key here
GROQ_MODEL=openai/gpt-oss-120b
# Search provider: duckduckgo (default, no key) or tavily
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=Enter tavily api key here
DATABASE_URL=sqlite:///./careerpilot.db
# PostgreSQL example: postgresql+psycopg2://user:password@localhost:5432/careerpilot
APP_ENV=development
LOG_LEVEL=INFO
MAX_ITERATIONS=2
MIN_GOOD_JOBS=3
VERIFY_TOP_N=10
MAX_RESULTS_PER_QUERY=8
HTTP_TIMEOUT=10
MAX_PDF_MB=5
RATE_LIMIT_PER_MIN=30
USE_SENTENCE_TRANSFORMERS=0
# MATCH_WEIGHTS={"skills":0.4,"semantic":0.2,"role":0.15,"experience":0.1,"education":0.05,"location":0.1}
API_URL=http://localhost:8000
